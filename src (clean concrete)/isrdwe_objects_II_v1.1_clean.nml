    property {
        class:                  "I203";
        classname:              string(STR_CAT03);
        name:                   string(STR_Fixtures);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  1;
        remove_cost_multiplier: 1;
        introduction_date:      0x00000000;
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           (param_scenario_editor==1 && param_irremovable==1) ? 2347 :
                                ((param_scenario_editor==1 && param_irremovable==0) ? 2349 :
                                ((param_scenario_editor==0 && param_irremovable==1) ? 2346 : 2348));
        height:                 2;
        num_views:              4;
    }
    graphics {
        default:                switch_Fixtures_10;
        purchase:               switch_Fixtures_10_menu;
    }
}

