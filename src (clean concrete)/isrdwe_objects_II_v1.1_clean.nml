item (FEAT_OBJECTS, Drive_through_tiles_15, 134) {
    property {
        class:                  "I208";
        classname:              string(STR_OVERLAP);
        name:                   string(STR_Overlapping_tiles);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  1;
        remove_cost_multiplier: 1;
        introduction_date:      0x00000000;
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           (param_scenario_editor==1 && param_irremovable==1) ? 2091 :
                                ((param_scenario_editor==1 && param_irremovable==0) ? 2093 :
                                ((param_scenario_editor==0 && param_irremovable==1) ? 2090 : 2092));
        height:                 2;
        num_views:              4;
    }
    graphics {
        default:                switch_Drive_through_tiles_15;
        purchase:               switch_Drive_through_tiles_15_menu;
    }
}

