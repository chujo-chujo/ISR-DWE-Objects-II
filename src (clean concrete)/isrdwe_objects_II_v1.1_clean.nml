// // OBJECT FLAGS
// ┌─────┬───────┬───────────────────────────┬───────────────────────────────────────────────────────────────────────┐
// │ Bit │ Value │ Name                      │ Meaning                                                               │
// ├─────┼───────┼───────────────────────────┼───────────────────────────────────────────────────────────────────────┤
// │ 0   │ 1     │ OBJ_FLAG_ONLY_SE          │ Only Available in the scenario editor                                 │
// │ 1   │ 2     │ OBJ_FLAG_IRREMOVABLE      │ Irremovable                                                           │
// │ 2   │ 4     │ OBJ_FLAG_ANYTHING_REMOVE  │ Anything Can Remove (owned land behaviour)                            │
// │ 3   │ 8     │ OBJ_FLAG_ON_WATER         │ Allow construction of the object on water                             │
// │ 4   │ 16    │ OBJ_FLAG_REMOVE_IS_INCOME │ Removal cost is actually income (owned land behaviour)                │
// │ 5   │ 32    │ OBJ_FLAG_NO_FOUNDATIONS   │ Do not display foundations if on a slope                              │
// │ 6   │ 64    │ OBJ_FLAG_ANIMATED         │ Object has animation                                                  │
// │ 7   │ 128   │ OBJ_FLAG_ONLY_INGAME      │ Only available during game play                                       │
// │ 8   │ 256   │ OBJ_FLAG_2CC              │ Allows 2cc mapping for objects instead of the default 1cc             │
// │ 9   │ 512   │ OBJ_FLAG_NOT_ON_LAND      │ Disallows construction on land (also has bit 3 behaviour)             │
// │ 10  │ 1024  │ OBJ_FLAG_DRAW_WATER       │ Draws the water under the object                                      │
// │ 11  │ 2048  │ OBJ_FLAG_ALLOW_BRIDGE     │ Allow bridge over the object taking the building height into account  │
// │ 12  │ 4096  │ OBJ_FLAG_RANDOM_ANIMATION │ Random bits in the "next animation frame" callback                    │
// │ 13  │ 8192  │ OBJ_FLAG_SCALE_BY_WATER   │ Scale amount of mapgen objects roughly by the length of the coastline │
// └─────┴───────┴───────────────────────────┴───────────────────────────────────────────────────────────────────────┘


// SEPARATOR IN PURCHASE MENU
spritelayout layout_menu_separator {
    ground { sprite: GROUNDSPRITE_CLEARED; }
    building { sprite: spriteset_GRN_TYPE2;
               hide_sprite: (1 - param_ground); }
    building { sprite: spriteset_GRN_TYPE1;
               hide_sprite: param_ground; }
}
item (FEAT_OBJECTS, menu_separator, 000) {
    property {
        class:                  "I200";
        classname:              string(STR_Separator);
        name:                   string(STR_Separator_menu);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  1;
        remove_cost_multiplier: 1;
        introduction_date:      0x00000000;
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           (param_scenario_editor==1 && param_irremovable==1) ? 3083 :
                                ( (param_scenario_editor==1 && param_irremovable==0) ? 3085 :
                                    ((param_scenario_editor==0 && param_irremovable==1) ? 3082 : 3084));
        height:                 2;
        num_views:              1;
    }
    graphics {
        default:                layout_menu_separator;
    }
}


